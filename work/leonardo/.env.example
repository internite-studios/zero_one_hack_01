# =============================================================================
# Leonardo Supercomputer — Credentials & Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to git — it's in .gitignore.
# =============================================================================

# --- SSH / Login ---
# Your CINECA username for Leonardo
LEONARDO_USER=your_username

# Login node (default: login01-ext)
LEONARDO_HOST=login01-ext.leonardo.cineca.it

# Alternative login nodes:
#   login01-ext.leonardo.cineca.it
#   login02-ext.leonardo.cineca.it
#   login05-ext.leonardo.cineca.it
#   login07-ext.leonardo.cineca.it

# --- SLURM ---
# Hackathon reservation (provided by organizers)
SLURM_RESERVATION=s_tra_ncc

# Default SLURM partition
SLURM_PARTITION=boost_usr_prod

# --- Proxy (low-bandwidth traffic only — drops connections periodically) ---
# All four variables use the same proxy IP (per official slides).
# Never use this for large downloads — get those on the login nodes.
HTTP_PROXY=http://proxyuser:5dd1d2bd00@10.99.0.1:38425
HTTPS_PROXY=http://proxyuser:5dd1d2bd00@10.99.0.1:38425

# --- Paths on Leonardo ---
# IMPORTANT: $WORK and $FAST are NOT available during the hackathon.
# Use $SCRATCH for everything. Files auto-deleted after 40 days.
# $HOME is 50 GB — use only for config, SSH keys, and pixi binary.
# $PUBLIC is 50 GB — can be used to share files between users.
LEONARDO_PROJECT_DIR=/scratch/${LEONARDO_USER}/zero-one-hack
LEONARDO_SCRATCH_DIR=/scratch/${LEONARDO_USER}

# --- pixi ---
PIXI_BIN=$HOME/.pixi/bin/pixi
PIXI_CACHE_DIR=/scratch/${LEONARDO_USER}/.pixi-cache

# --- HuggingFace (optional — uncomment and fill in if needed) ---
# HF_TOKEN=hf_your_token_here
